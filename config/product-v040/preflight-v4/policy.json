{
  "schema_version": "ecomsre.preflight.v4.policy.v3",
  "probe_namespace": "independent",
  "probe_death_before_sandbox_birth": true,
  "kafka_paths": [
    "/etc/kafka/secrets",
    "/mnt/shared/config",
    "/var/lib/kafka/data"
  ],
  "process_uid": 1000,
  "process_gid": 1000,
  "capabilities": 0,
  "no_new_privileges": true,
  "runtime_chown_chmod": false,
  "cleanup_authority": "verified-plan-and-birth-receipt",
  "one_target_per_cleanup_command": true,
  "force_kill_prune": false,
  "remediation_profile": "ABSENT",
  "formal_authority": "NONE",
  "provider_calls": 0,
  "readiness_policy": "exact-role-birth-id-with-contemporaneous-evidence",
  "oom_representation_policy": "probe-only-false-to-null-bound-effective-cgroup-proof-v1",
  "mount_order_policy": "exact-target-keyed-mount-content-v2",
  "daemon_readiness": "version-info-only; authorized-build-immediately-before-fresh-baseline",
  "prior_failed_attempt_recovery": "only-tracked-commitment-to-independent-daemon-event-and-exact-owned-cleanup",
  "environment_unset_policy": "only-bare-keys-explicitly-null-in-frozen-service; never-empty-or-assigned",
  "image_descriptor_policy": "exact-frozen-index-and-platform; linux-arm64-with-absent-or-v8-variant-only",
  "network_default_options_policy": "exact-ipv4-true-ipv6-false-on-ordinary-bridge-local-only"
}
