  "formulas": {
    "F0": {
      "definition": "abs(post_mean-pre_mean)/max(abs(pre_mean),epsilon)",
      "epsilon": 1e-09
    },
    "F1": {
      "definition": "abs(post_median-pre_median)/max(1.4826*pre_mad,scale_floor)",
      "mad_multiplier": 1.4826,
      "scale_floor": 1e-09
    },
    "F2": {
      "clip": 20.0,
      "definition": "max(min(F0,clip),min(F1,clip))+persistence_bonus",
      "persistence_bonus": 1.0,
      "persistence_gate": 0.5,
      "persistence_threshold": "max(3*1.4826*pre_mad,1e-9)"
    }
  },
